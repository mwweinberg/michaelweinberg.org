{
  "name": "michaelweinberg-org",
  "version": "1.0.0",
  "description": "Michael Weinberg's personal website",
  "scripts": {
    "build": "mkdir -p _site/assets/css && sass assets/css/main.scss _site/assets/css/main.css --load-path _sass --no-source-map --style compressed && eleventy",
    "serve": "concurrently \"sass assets/css/main.scss _site/assets/css/main.css --load-path _sass --no-source-map --watch\" \"eleventy --serve\"",
    "clean": "rm -rf _site"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "concurrently": "^9.0.0",
    "sass": "^1.77.0"
  }
}
